# Copy this file to `.env` (git-ignored) and fill in values locally.
# NEVER commit a real `.env` or any real credential value.

# --- Meta Model API / Muse advisory (all optional; advisory layer only) ---
# Base URL of the Meta Model API endpoint used by muse/adapter.py
MUSE_MODEL_API_URL=
# Secret key — keep local only; never put this in source, CI, or logs
MUSE_MODEL_API_KEY=
# Model name to request
MUSE_MODEL_NAME=
# Request timeout in seconds
MUSE_MODEL_TIMEOUT_S=
# Maximum tokens for advisory responses
MUSE_MODEL_MAX_TOKENS=
